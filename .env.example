# Copy this file to .env and fill in your own keys. Never commit .env.
# Leave a key empty to disable that service: the rule-based analysis still works.

# https://www.virustotal.com -> profile -> API key
VIRUSTOTAL_API_KEY=
# https://www.abuseipdb.com -> Account -> API
ABUSEIPDB_API_KEY=
# https://auth.abuse.ch -> Auth-Key
URLHAUS_AUTH_KEY=

# Seconds to wait for an outside service before skipping it
INTEL_TIMEOUT=5
